# HealthSpan environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Session signing/encryption secret (at least 32 characters; use a strong random value)
SESSION_SECRET=

# Application URL
APP_URL=http://localhost:3000

# Data directory (legacy JSON retained for reference/migration)
DATA_DIRECTORY=./data

# LLM provider (optional) for lab-report OCR extraction.
# When LLM_PROVIDER_API_KEY is empty, the app falls back to deterministic demo
# data (no network/tesseract). Any OpenAI-compatible '/chat/completions' endpoint
# works: OpenAI, Azure, Together, Groq, Google Gemini, local Ollama, etc.
#
# IMPORTANT: BASE_URL must be the base that the client appends '/chat/completions'
# to. OpenAI: https://api.openai.com/v1
# Google Gemini (OpenAI-compatible): https://generativelanguage.googleapis.com/v1beta/openai
#   (NOT the bare root or '/v1beta', which return 404.)
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
# Replace with your real provider key. Never commit a real key to this file.
LLM_PROVIDER_API_KEY=PASTE_YOUR_PROVIDER_API_KEY_HERE
LLM_MODEL=gpt-4o-mini